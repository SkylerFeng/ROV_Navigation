#usda 1.0
(
    customLayerData = {
        string scenario = "platform_ego_mixed"
        string title = "Platform water / mixed obstacles"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment"
    {
        double3 xformOp:translate = (-5, -1.5, 1.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Platform" (
            prepend references = @/home/ache/OceanSim-Highbay/data/Platform(new1)/Platform_black_water.usda@
        )
        {
            over "Water"
            {
                over "Looks"
                {
                    over "Water"
                    {
                        over "PreviewSurface"
                        {
                            float inputs:ior = 1
                            float inputs:opacity = 0.1
                            float inputs:roughness = 0.85
                            color3f inputs:specularColor = (0, 0, 0)
                            int inputs:useSpecularWorkflow = 1
                        }
                    }
                }
            }
        }
    }

    def Xform "Water"
    {
    }

    def "Obstacles"
    {
        def Cube "BoxA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/BoxA>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.25, 0.5, 0.82)
            double3 xformOp:translate = (-0.75, 0.2, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "PillarA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 1
            rel material:binding = </World/ObstacleMaterials/PillarA>
            color3f[] primvars:displayColor = [(0.12, 0.65, 0.85)]
            double radius = 0.5
            float3 xformOp:scale = (0.25, 0.25, 0.82)
            double3 xformOp:translate = (0, -0.25, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BoxB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/BoxB>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.25, 0.5, 0.82)
            double3 xformOp:translate = (0.75, 0.25, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "ObstacleMaterials"
    {
        def Material "BoxA"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/BoxA/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "PillarA"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/PillarA/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.65, 0.85)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "BoxB"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/BoxB/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def "Markers"
    {
        def Sphere "Start"
        {
            color3f[] primvars:displayColor = [(0.1, 0.9, 0.2)]
            double radius = 0.1
            double3 xformOp:translate = (-2, 0, 1.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Goal"
        {
            color3f[] primvars:displayColor = [(0.1, 0.4, 1)]
            double radius = 0.1
            double3 xformOp:translate = (2.1, 0, 1.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "ROV" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @/home/ache/OceanSim_assets/Bluerov/BROV_low.usd@
    )
    {
        float physics:mass = 5
        double3 xformOp:translate = (-2, 0, 1)

        def Cube "CollisionHull" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.48, 0.57, 0.26)
            double3 xformOp:translate = (0, 0, 0.116)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        float physics:gravityMagnitude = 0
    }
}

