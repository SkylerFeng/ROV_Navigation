#usda 1.0
(
    customLayerData = {
        string scenario = "highbay_open"
        string title = "HighBay / 实景网格空场测试"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment"
    {
        double3 xformOp:translate = (14, 9, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Platform" (
            prepend references = @/home/ache/OceanSim-Highbay/data/HighBay/HighBay.usd@
        )
        {
        }
    }

    def Xform "Water" (
        prepend references = @/home/ache/Coding/rov_navigation/scenes/highbay_water.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Looks"
        {
            over "Water"
            {
                over "PreviewSurface"
                {
                    float inputs:ior = 1
                    float inputs:opacity = 0.12
                    float inputs:roughness = 0.85
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                }
            }
        }
    }

    def "Markers"
    {
        def Sphere "Start"
        {
            color3f[] primvars:displayColor = [(0.1, 0.9, 0.2)]
            double radius = 0.1
            double3 xformOp:translate = (-3, -0.5, 1.6500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Goal"
        {
            color3f[] primvars:displayColor = [(0.1, 0.4, 1)]
            double radius = 0.1
            double3 xformOp:translate = (3, 0.4, 1.6500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "ROV" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @/home/ache/OceanSim_assets/Bluerov/BROV_low.usd@
    )
    {
        float physics:mass = 5
        double3 xformOp:translate = (-3, -0.5, 1)

        def Cube "CollisionHull" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.48, 0.57, 0.26)
            double3 xformOp:translate = (0, 0, 0.116)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        float physics:gravityMagnitude = 0
    }
}
