            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "OuterA"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/OuterA/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.65, 0.85)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "OuterB"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/OuterB/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.65, 0.85)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "EntryBlock"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/EntryBlock/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "ExitBlock"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/ExitBlock/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def "Markers"
    {
        def Sphere "Start"
        {
            color3f[] primvars:displayColor = [(0.1, 0.9, 0.2)]
            double radius = 0.1
            double3 xformOp:translate = (-3, 0, 1.6500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Goal"
        {
            color3f[] primvars:displayColor = [(0.1, 0.4, 1)]
            double radius = 0.1
            double3 xformOp:translate = (3.5, 0.4, 1.6500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "ROV" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @/home/ache/OceanSim_assets/Bluerov/BROV_low.usd@
    )
    {
        float physics:mass = 5
        double3 xformOp:translate = (-3, 0, 1)

        def Cube "CollisionHull" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.48, 0.57, 0.26)
            double3 xformOp:translate = (0, 0, 0.116)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        float physics:gravityMagnitude = 0
    }
}

