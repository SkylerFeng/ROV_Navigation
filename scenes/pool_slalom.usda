#usda 1.0
(
    customLayerData = {
        string scenario = "slalom"
        string title = "Slalom / 交错绕行"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment"
    {
        double3 xformOp:translate = (-7.5, -0.289182, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Platform" (
            prepend references = @/home/ache/Platform1013/Platform/Platform.final.usd@
        )
        {
        }
    }

    def Xform "Water" (
        prepend references = @/home/ache/Platform1013/Platform/Tile3_water.usda@
    )
    {
        double3 xformOp:translate = (-7.500032, -4, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Looks"
        {
            over "Water"
            {
                over "PreviewSurface"
                {
                    float inputs:ior = 1
                    float inputs:opacity = 0.12
                    float inputs:roughness = 0.85
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                }
            }
        }
    }

    def "Obstacles"
    {
        def Cube "SlalomA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/SlalomA>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.45, 0.85, 0.85)
            double3 xformOp:translate = (-1.5, -0.15, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SlalomB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/SlalomB>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.45, 0.8, 0.85)
            double3 xformOp:translate = (0.05, 1.05, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SlalomC" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/SlalomC>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.45, 0.8, 0.85)
            double3 xformOp:translate = (1.6, -0.1, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "OuterA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 1
            rel material:binding = </World/ObstacleMaterials/OuterA>
            color3f[] primvars:displayColor = [(0.12, 0.65, 0.85)]
            double radius = 0.5
            float3 xformOp:scale = (0.45, 0.45, 0.85)
            double3 xformOp:translate = (-0.8, -1.5, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "OuterB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 1
            rel material:binding = </World/ObstacleMaterials/OuterB>
            color3f[] primvars:displayColor = [(0.12, 0.65, 0.85)]
            double radius = 0.5
            float3 xformOp:scale = (0.45, 0.45, 0.85)
            double3 xformOp:translate = (2.4, 2.35, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "EntryBlock" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/EntryBlock>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.5, 0.6, 0.85)
            double3 xformOp:translate = (-2.9, -1.5, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ExitBlock" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/ExitBlock>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.5, 0.6, 0.85)
            double3 xformOp:translate = (3.5, -1.45, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "ObstacleMaterials"
    {
        def Material "SlalomA"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/SlalomA/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "SlalomB"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/SlalomB/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
