#usda 1.0
(
    customLayerData = {
        string scenario = "baseline"
        string title = "Baseline / 三障碍基准"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment"
    {
        double3 xformOp:translate = (-7.5, -0.289182, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Platform" (
            prepend references = @/home/ache/Platform1013/Platform/Platform.final.usd@
        )
        {
        }
    }

    def Xform "Water" (
        prepend references = @/home/ache/Platform1013/Platform/Tile3_water.usda@
    )
    {
        double3 xformOp:translate = (-7.500032, -4, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Looks"
        {
            over "Water"
            {
                over "PreviewSurface"
                {
                    float inputs:ior = 1
                    float inputs:opacity = 0.12
                    float inputs:roughness = 0.85
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                }
            }
        }
    }

    def "Obstacles"
    {
        def Cube "BlockA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/BlockA>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.5, 0.6, 0.85)
            double3 xformOp:translate = (-1.3, 0, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BlockB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/BlockB>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.5, 0.6, 0.85)
            double3 xformOp:translate = (0.4, 0.45, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BlockC" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/BlockC>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.5, 0.6, 0.85)
            double3 xformOp:translate = (2, -0.3, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "ObstacleMaterials"
    {
        def Material "BlockA"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/BlockA/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "BlockB"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/BlockB/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "BlockC"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/BlockC/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def "Markers"
    {
        def Sphere "Start"
        {
            color3f[] primvars:displayColor = [(0.1, 0.9, 0.2)]
            double radius = 0.1
            double3 xformOp:translate = (-3, 0, 1.6500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Goal"
        {
            color3f[] primvars:displayColor = [(0.1, 0.4, 1)]
            double radius = 0.1
            double3 xformOp:translate = (3.5, 0.4, 1.6500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "ROV" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @/home/ache/OceanSim_assets/Bluerov/BROV_low.usd@
    )
    {
        float physics:mass = 5
        double3 xformOp:translate = (-3, 0, 1)

        def Cube "CollisionHull" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.48, 0.57, 0.26)
            double3 xformOp:translate = (0, 0, 0.116)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        float physics:gravityMagnitude = 0
    }
}

