    def "Materials"
    {
        def Material "PoolCeramic"
        {
            token outputs:surface.connect = </World/Materials/PoolCeramic/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.64, 0.68)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "Deck"
        {
            token outputs:surface.connect = </World/Materials/Deck/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.19, 0.23)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }

    def Cube "Deck" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Materials/Deck>
        double size = 1
        float3 xformOp:scale = (22, 16, 0.18)
        double3 xformOp:translate = (0, 0, 0.45000000000000007)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Lighting"
    {
        def DomeLight "Dome"
        {
            float inputs:intensity = 650
        }

        def DistantLight "Key"
        {
            float inputs:angle = 12
            float inputs:intensity = 1800
            float3 xformOp:rotateXYZ = (-25, -35, 20)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Camera "Overview"
    {
        float2 clippingRange = (0.1, 100)
        matrix4d xformOp:transform = ( (0.7926239891046002, 0.6097107608496924, -2.7755575615628914e-17, 0), (-0.37873039172055595, 0.49234950923672277, 0.7836805797909966, -0), (0.47781848256749654, -0.6211640273377456, 0.6211640273377455, 0), (10, -13.000000000000002, 13.999999999999998, 0.9999999999999999) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Xform "Water" (
        prepend references = @/home/ache/OceanSim-Highbay/data/Platform(new1)/Tile3_water.usda@
    )
    {
        double3 xformOp:translate = (-5.8, -4.65, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Looks"
        {
            over "Water"
            {
                over "PreviewSurface"
                {
                    color3f inputs:diffuseColor = (0.12, 0.45, 0.55)
                    float inputs:ior = 1
                    float inputs:opacity = 0.08
                    float inputs:roughness = 0.85
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                }
            }
        }
    }

    def "Obstacles"
    {
        def Cube "TrainingBlock" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/TrainingBlock>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.65, 0.8, 0.8)
            double3 xformOp:translate = (0, 0, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "ObstacleMaterials"
    {
        def Material "TrainingBlock"
        {
            token outputs:surface.connect = </World/ObstacleMaterials/TrainingBlock/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.28, 0.08)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def "Markers"
