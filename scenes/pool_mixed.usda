#usda 1.0
(
    customLayerData = {
        string scenario = "mixed"
        string title = "Mixed yard / 混合障碍区"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment"
    {
        double3 xformOp:translate = (-7.5, -0.289182, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Platform" (
            prepend references = @/home/ache/Platform1013/Platform/Platform.final.usd@
        )
        {
        }
    }

    def Xform "Water" (
        prepend references = @/home/ache/Platform1013/Platform/Tile3_water.usda@
    )
    {
        double3 xformOp:translate = (-7.500032, -4, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Looks"
        {
            over "Water"
            {
                over "PreviewSurface"
                {
                    float inputs:ior = 1
                    float inputs:opacity = 0.12
                    float inputs:roughness = 0.85
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                }
            }
        }
    }

    def "Obstacles"
    {
        def Cube "CrateA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/CrateA>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.65, 0.75, 0.85)
            double3 xformOp:translate = (-1.4, -0.15, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "CrateB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/ObstacleMaterials/CrateB>
            color3f[] primvars:displayColor = [(0.9, 0.28, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.6, 0.65, 0.85)
            double3 xformOp:translate = (0.6, 0.05, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ShortWall" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
