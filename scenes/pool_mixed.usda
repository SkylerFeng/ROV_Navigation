            double3 xformOp:translate = (2.3, -0.25, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "PipeA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 1
            rel material:binding = </World/ObstacleMaterials/PipeA>
            color3f[] primvars:displayColor = [(0.12, 0.65, 0.85)]
            double radius = 0.5
            float3 xformOp:scale = (0.5, 0.5, 0.85)
            double3 xformOp:translate = (-2.9, 2.2, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "PipeB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
