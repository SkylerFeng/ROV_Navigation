#usda 1.0
(
    defaultPrim = "Water"
    metersPerUnit = 1
    upAxis = "Z"
    customLayerData = {
        string description = "Configured test water, not measured HighBay water geometry. Fluid forces are applied by run_sim.py."
    }
)
def Xform "Water"
{
    def Mesh "Surface" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [(-4, -2.4, 1.55), (3.5, -2.4, 1.55), (3.5, 2.4, 1.55), (-4, 2.4, 1.55)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = true
        rel material:binding = </Water/Looks/Water>
    }
    def Scope "Looks"
    {
        def Material "Water"
        {
            token outputs:surface.connect = </Water/Looks/Water/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.32, 0.5)
                float inputs:opacity = 0.25
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }
}
