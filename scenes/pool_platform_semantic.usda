            color3f[] primvars:displayColor = [(0.8, 0.04, 0.04)]
            custom string semantic:category = "box"
            double size = 1
            float xformOp:rotateZ = 15
            float3 xformOp:scale = (0.38, 0.38, 0.38)
            double3 xformOp:translate = (-0.6, 1, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }
    }

    def "SemanticMaterials"
    {
        def Material "yellow"
        {
            token outputs:surface.connect = </World/SemanticMaterials/yellow/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.75, 0.03)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "blue"
        {
            token outputs:surface.connect = </World/SemanticMaterials/blue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.15, 0.85)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </World/SemanticMaterials/red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.04, 0.04)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }

    over "ROV"
    {
        def SphereLight "InspectionLight"
        {
            color3f inputs:color = (1, 0.97, 0.92)
            float inputs:intensity = 250
            bool inputs:normalize = 1
            float inputs:radius = 0.04
            double3 xformOp:translate = (0.35, 0, 0.12)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    over "Environment"
    {
        over "Platform"
        {
            over "Water"
            {
                over "Looks"
                {
                    over "Water"
                    {
                        over "PreviewSurface"
                        {
                            float inputs:ior = 1.333
                            float inputs:opacity = 0.38
                            float inputs:roughness = 0.12
                            color3f inputs:specularColor = (1, 1, 1)
                            int inputs:useSpecularWorkflow = 0
                        }
                    }
                }
            }
        }
    }
}
